import { Theme } from "theme.slint";

// One line of the preset popup. Rows are built by `ui/presets_view.rs`.
export struct PresetRowItem {
    header: bool,
    label: string,
    active: bool,
}

// Which modal dialog is open. `none` means no dialog.
export enum PresetDialogKind {
    none,
    name,
    confirm,
}

// Small text button of the presets bar. Disabled buttons stay visible but dimmed.
component PresetButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    callback clicked();

    height: 32px;
    border-radius: Theme.radius-control;
    border-width: 1px;
    border-color: Theme.card-border;
    background: touch.pressed ? #262a31 : (touch.has-hover ? #222630 : Theme.card);
    opacity: root.enabled ? 1.0 : 0.45;
    animate background { duration: 80ms; }

    Text {
        text: root.text;
        color: Theme.text;
        font-size: Theme.font-body;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        width: parent.width;
        height: parent.height;
        enabled: root.enabled;
        clicked => {
            root.clicked();
        }
    }
}

// Preset dropdown: a rounded control showing the active preset (or "Custom") and a popup list
// grouped into "Built-in" and "My presets". Clicking a preset selects it and closes the list.
component PresetSelector inherits Rectangle {
    in property <string> label;
    in property <bool> modified: false;
    in property <[PresetRowItem]> rows;
    callback selected(string);

    // One line per row, capped so that a long list scrolls inside the popup.
    private property <length> list-height: min(320px, root.rows.length * 28px + 8px);

    width: 200px;
    height: 32px;
    border-radius: Theme.radius-control;
    border-width: 1px;
    border-color: popup.is-open ? Theme.accent : Theme.card-border;
    background: touch.has-hover ? #222630 : Theme.background;
    animate background, border-color { duration: Theme.transition; }

    HorizontalLayout {
        padding-left: Theme.space-s;
        padding-right: Theme.space-s;
        spacing: 6px;

        Text {
            text: root.label;
            color: Theme.text;
            font-size: Theme.font-body;
            overflow: elide;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }

        if root.modified : Text {
            text: "\u{2022} modified";
            color: Theme.text-muted;
            font-size: Theme.font-small;
            font-italic: true;
            vertical-alignment: center;
        }

        Rectangle {
            width: 12px;

            Path {
                x: 1px;
                y: (parent.height - self.height) / 2;
                width: 10px;
                height: 6px;
                viewbox-width: 10;
                viewbox-height: 6;
                commands: "M 1 1 L 5 5 L 9 1";
                fill: transparent;
                stroke: Theme.text-muted;
                stroke-width: 1.5px;
                stroke-line-cap: round;
            }
        }
    }

    touch := TouchArea {
        width: parent.width;
        height: parent.height;
        clicked => {
            if (popup.is-open) {
                popup.close();
            } else {
                popup.show();
            }
        }
    }

    popup := PopupWindow {
        x: 0px;
        y: root.height + 4px;
        width: root.width;
        height: root.list-height;

        Rectangle {
            width: root.width;
            height: root.list-height;
            background: Theme.card;
            border-radius: Theme.radius-control;
            border-width: 1px;
            border-color: Theme.card-border;

            Flickable {
                x: 4px;
                y: 4px;
                width: root.width - 8px;
                height: root.list-height - 8px;
                content-width: self.width;
                content-height: list.preferred-height;

                list := VerticalLayout {
                    width: root.width - 8px;

                    for row in root.rows : Rectangle {
                        height: row.header ? 26px : 28px;
                        border-radius: Theme.radius-control;
                        background: row.active
                            ? Theme.accent-soft
                            : (!row.header && item-touch.has-hover ? #262a31 : transparent);

                        Text {
                            x: Theme.space-s;
                            width: parent.width - 2 * Theme.space-s;
                            height: parent.height;
                            text: row.label;
                            color: row.header ? Theme.text-muted : (row.active ? Theme.accent : Theme.text);
                            font-size: row.header ? Theme.font-small : Theme.font-body;
                            font-weight: row.header ? 600 : 400;
                            vertical-alignment: center;
                            overflow: elide;
                        }

                        item-touch := TouchArea {
                            width: parent.width;
                            height: parent.height;
                            enabled: !row.header;
                            clicked => {
                                root.selected(row.label);
                                popup.close();
                            }
                        }
                    }
                }
            }
        }
    }
}

// The presets bar in the equaliser header: the dropdown, then Save, Save as, Rename and Delete.
// Which actions are enabled is decided by the owner; "Save as" is always available.
export component PresetBar inherits HorizontalLayout {
    in property <string> label;
    in property <bool> modified: false;
    in property <[PresetRowItem]> rows;
    in property <bool> can-save: false;
    in property <bool> can-rename: false;
    in property <bool> can-delete: false;
    callback selected(string);
    callback save-clicked();
    callback save-as-clicked();
    callback rename-clicked();
    callback delete-clicked();

    spacing: Theme.space-xs;

    PresetSelector {
        label: root.label;
        modified: root.modified;
        rows: root.rows;
        selected(name) => {
            root.selected(name);
        }
    }

    PresetButton {
        width: 56px;
        text: "Save";
        enabled: root.can-save;
        clicked => {
            root.save-clicked();
        }
    }

    PresetButton {
        width: 86px;
        text: "Save as\u{2026}";
        clicked => {
            root.save-as-clicked();
        }
    }

    PresetButton {
        width: 86px;
        text: "Rename\u{2026}";
        enabled: root.can-rename;
        clicked => {
            root.rename-clicked();
        }
    }

    PresetButton {
        width: 70px;
        text: "Delete";
        enabled: root.can-delete;
        clicked => {
            root.delete-clicked();
        }
    }
}

// Button of a dialog. The primary button is filled; `danger` turns the fill red.
component DialogButton inherits Rectangle {
    in property <string> text;
    in property <bool> primary: false;
    in property <bool> danger: false;
    in property <bool> enabled: true;
    callback clicked();

    height: 32px;
    border-radius: Theme.radius-control;
    border-width: root.primary ? 0px : 1px;
    border-color: Theme.card-border;
    background: root.danger
        ? (touch.pressed ? #dc2626 : Theme.danger)
        : (root.primary
            ? (touch.pressed ? #2563eb : Theme.accent)
            : (touch.pressed ? #262a31 : (touch.has-hover ? #222630 : Theme.background)));
    opacity: root.enabled ? 1.0 : 0.45;
    animate background { duration: 80ms; }

    Text {
        text: root.text;
        color: root.primary ? Theme.on-accent : Theme.text;
        font-size: Theme.font-body;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        width: parent.width;
        height: parent.height;
        enabled: root.enabled;
        clicked => {
            root.clicked();
        }
    }
}

// Modal dialog with one name field, used for "Save as" and "Rename". Enter confirms (only when
// `ok-enabled`), Escape cancels. The owner validates the text and sets `error`.
export component PresetNameDialog inherits Rectangle {
    in property <string> title;
    in property <string> ok-text;
    in property <bool> ok-enabled: false;
    in property <string> error;
    in-out property <string> text;
    callback ok(string);
    callback cancel();
    callback edited(string);

    background: #000000a6;

    // Keeps the window underneath inert while the dialog is open.
    TouchArea {
        width: parent.width;
        height: parent.height;
    }

    scope := FocusScope {
        width: parent.width;
        height: parent.height;
        forward-focus: input;
    }

    init => {
        scope.focus();
    }

    card := Rectangle {
        width: 380px;
        height: body.preferred-height;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: Theme.card;
        border-radius: Theme.radius-card;
        border-width: 1px;
        border-color: Theme.card-border;

        body := VerticalLayout {
            padding: Theme.space-l;
            spacing: Theme.space-s;

            Text {
                text: root.title;
                color: Theme.text;
                font-size: Theme.font-title;
                font-weight: 600;
            }

            Rectangle {
                height: 34px;
                border-radius: Theme.radius-control;
                border-width: 1px;
                border-color: input.has-focus ? Theme.accent : Theme.card-border;
                background: Theme.background;

                input := TextInput {
                    x: Theme.space-s;
                    width: parent.width - 2 * Theme.space-s;
                    height: parent.height;
                    text <=> root.text;
                    color: Theme.text;
                    font-size: Theme.font-body;
                    single-line: true;
                    vertical-alignment: center;

                    accepted => {
                        if (root.ok-enabled) {
                            root.ok(self.text);
                        }
                    }
                    edited => {
                        root.edited(self.text);
                    }
                    key-pressed(event) => {
                        if (event.text == Key.Escape) {
                            root.cancel();
                            return accept;
                        }
                        return reject;
                    }
                }
            }

            if root.error != "" : Text {
                text: root.error;
                color: Theme.danger;
                font-size: Theme.font-small;
                wrap: word-wrap;
            }

            HorizontalLayout {
                alignment: end;
                spacing: Theme.space-xs;

                DialogButton {
                    width: 88px;
                    text: "Cancel";
                    clicked => {
                        root.cancel();
                    }
                }

                DialogButton {
                    width: 88px;
                    text: root.ok-text;
                    primary: true;
                    enabled: root.ok-enabled;
                    clicked => {
                        if (root.ok-enabled) {
                            root.ok(input.text);
                        }
                    }
                }
            }
        }
    }
}

// Modal confirmation with a title and Delete / Cancel. Enter confirms, Escape cancels.
export component PresetConfirmDialog inherits Rectangle {
    in property <string> title;
    in property <string> ok-text;
    callback ok();
    callback cancel();

    background: #000000a6;

    TouchArea {
        width: parent.width;
        height: parent.height;
    }

    scope := FocusScope {
        width: parent.width;
        height: parent.height;

        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.cancel();
                return accept;
            }
            if (event.text == Key.Return) {
                root.ok();
                return accept;
            }
            return reject;
        }
    }

    init => {
        scope.focus();
    }

    card := Rectangle {
        width: 380px;
        height: body.preferred-height;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: Theme.card;
        border-radius: Theme.radius-card;
        border-width: 1px;
        border-color: Theme.card-border;

        body := VerticalLayout {
            padding: Theme.space-l;
            spacing: Theme.space-l;

            Text {
                text: root.title;
                color: Theme.text;
                font-size: Theme.font-title;
                font-weight: 600;
                wrap: word-wrap;
            }

            HorizontalLayout {
                alignment: end;
                spacing: Theme.space-xs;

                DialogButton {
                    width: 88px;
                    text: "Cancel";
                    clicked => {
                        root.cancel();
                    }
                }

                DialogButton {
                    width: 88px;
                    text: root.ok-text;
                    danger: true;
                    clicked => {
                        root.ok();
                    }
                }
            }
        }
    }
}
